# Exa (real web search via JSON API), used by the in-room PC's search
# feature. Free tier: 20,000 requests/month, no credit card required,
# renews every month:
#   https://exa.ai
# Copy this file to .env and fill in your own key — .env is gitignored and
# is only ever read server-side (see vite.config.ts), never bundled into
# the client.
EXA_API_KEY=

# Firebase (Firestore database for the certificate frames, bedside photo,
# and books shelved in the bookshelf). Free "Spark" plan, no credit card
# required: https://firebase.google.com
# Create a project (Firebase console -> Add project), add a Web app to it,
# and copy these from the config snippet it gives you. Also enable Firestore
# (Build -> Firestore Database -> Create database) and set its Security
# Rules (see README / the setup instructions given alongside this file).
# Unlike the key above, this whole config IS meant to be public
# (VITE_-prefixed = sent to the browser) — Firebase apps ship this in every
# client; access is controlled by Firestore Security Rules, not by keeping
# it secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Firebase account allowed to edit the room (certificate frames and the
# bedside photo). Leave empty and nobody can edit — the safe default.
# Get it from Firebase console -> Authentication -> Users after signing in
# once via the site's ?admin=1 URL. This value is public and is only used
# to decide whether to *offer* the Settings panel; the real enforcement is
# in firestore.rules, which needs the same uid pasted into it.
VITE_OWNER_UID=
